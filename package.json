{
  "name": "@pardnchiu/nanomd",
  "version": "2.0.9",
  "description": "A TypeScript Markdown parser with a JSON AST, on-demand Mermaid/KaTeX/Chart.js rendering, and sanitized HTML output",
  "type": "module",
  "main": "dist/parser.js",
  "module": "dist/parser.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/parser.esm.js",
      "default": "./dist/parser.esm.js"
    },
    "./parser.css": "./dist/parser.css"
  },
  "scripts": {
    "build:check": "tsc -p src/parser",
    "build:iife": "esbuild src/parser/index.ts --bundle --format=iife --global-name=MDParser --target=es2022 --minify --outfile=dist/parser.js --log-override:empty-import-meta=silent",
    "build:debug": "esbuild src/parser/index.ts --bundle --format=iife --global-name=MDParser --target=es2022 --outfile=dist/parser.debug.js --log-override:empty-import-meta=silent",
    "build:esm": "esbuild src/parser/index.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/parser.esm.js",
    "build:types": "tsc -p src/parser --noEmit false --declaration --emitDeclarationOnly --outDir dist/types",
    "build:css": "sass src/sass:dist/ --style compressed --no-source-map",
    "build:once": "npm-run-all build:check build:iife build:debug build:esm build:types build:css",
    "build": "chokidar \"src/parser/*.ts\" \"src/sass/*.scss\" -c \"npm run build:once\""
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/parser.debug.js",
    "!dist/test.html",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pardnchiu/NanoMD.git"
  },
  "keywords": [
    "markdown",
    "markdown-parser",
    "markdown-to-html",
    "markdown-ast",
    "gfm",
    "mermaid",
    "katex",
    "typescript"
  ],
  "author": {
    "name": "邱敬幃 Pardn Chiu",
    "email": "dev@pardn.io",
    "url": "https://pardn.io/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pardnchiu/NanoMD/issues",
    "email": "dev@pardn.io"
  },
  "homepage": "https://nanomd.pardn.io/",
  "devDependencies": {
    "chokidar-cli": "3.0.0",
    "esbuild": "0.28.2",
    "npm-run-all": "^4.1.5",
    "sass": "1.62.0",
    "typescript": "7.0.2"
  }
}
